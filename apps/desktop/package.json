{
  "name": "@styx/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Styx — project, agent and repo switcher",
  "main": "./out/main/index.js",
  "author": "Styx",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "e2e": "env -u ELECTRON_RUN_AS_NODE playwright test -c e2e/playwright.config.ts",
    "visual": "env -u ELECTRON_RUN_AS_NODE playwright test -c e2e/playwright.config.ts --project visual",
    "visual:baseline": "node --experimental-strip-types e2e/visual/bake-baseline.ts",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3,node-pty",
    "postinstall": "electron-builder install-app-deps",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "visual:report": "node --experimental-strip-types e2e/visual/report.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "^3.1126.0",
    "@msgpack/msgpack": "^3.1.3",
    "@napi-rs/keyring": "^2.0.0",
    "@styx/broker": "workspace:*",
    "@styx/core": "workspace:*",
    "@styx/tokens": "workspace:*",
    "@styx/ui": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "drizzle-orm": "^0.45.2",
    "electron-log": "^5.4.4",
    "execa": "^10.0.1",
    "jose": "^6.2.11",
    "node-pty": "^1.1.0",
    "parse-diff": "^0.12.0",
    "ssh2": "^1.17.0",
    "ulid": "^3.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "drizzle-kit": "^0.31.10",
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "immer": "^11.1.18",
    "monaco-editor": "^0.56.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^7.0.0",
    "zustand": "^5.0.15"
  }
}
