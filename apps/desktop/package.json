{
  "name": "@styx/desktop",
  "productName": "Styx",
  "version": "0.4.4",
  "license": "Apache-2.0",
  "private": true,
  "description": "Styx — project, agent and repo switcher",
  "main": "./out/main/index.js",
  "author": "Styx",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm run build:cli && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "e2e": "node --experimental-strip-types e2e/run.ts --project e2e",
    "readme:gif": "bash scripts/readme-gif.sh",
    "visual": "node --experimental-strip-types e2e/run.ts --project visual",
    "visual:baseline": "node --experimental-strip-types e2e/visual/bake-baseline.ts",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3,node-pty",
    "postinstall": "electron-builder install-app-deps",
    "package:mac": "pnpm run build && STYX_NOTARIZE=1 electron-builder --mac",
    "package:win": "pnpm run build && electron-builder --win",
    "release:preflight": "bash scripts/release-preflight.sh",
    "release:publish": "bash scripts/release-publish.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "visual:report": "node --experimental-strip-types e2e/visual/report.ts",
    "build:cli": "pnpm -F @styx/cli build && node scripts/copy-cli.mjs",
    "package:mac:dir": "pnpm run build && electron-builder --mac --dir",
    "package:win:dir": "pnpm run build && electron-builder --win --dir",
    "package:win:store": "pnpm run build && electron-builder --win appx",
    "package:smoke": "node --experimental-strip-types e2e/run.ts --project e2e --grep packaged"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "^3.1126.0",
    "@msgpack/msgpack": "^3.1.3",
    "@napi-rs/keyring": "^2.0.0",
    "@tanstack/react-virtual": "^3.14.10",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "cross-spawn": "^7.0.6",
    "drizzle-orm": "^0.45.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "execa": "^10.0.1",
    "jose": "^6.2.11",
    "node-pty": "^1.1.0",
    "parse-diff": "^0.12.0",
    "ssh2": "^1.17.0",
    "ulid": "^3.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@styx/broker": "workspace:*",
    "@styx/core": "workspace:*",
    "@styx/tokens": "workspace:*",
    "@styx/ui": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cross-spawn": "^6.0.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "drizzle-kit": "^0.31.10",
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "immer": "^11.1.18",
    "monaco-editor": "^0.56.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^7.0.0",
    "zustand": "^5.0.15"
  },
  "packageManager": "pnpm@10.28.1"
}
