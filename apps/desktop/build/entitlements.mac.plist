<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- V8 must map executable memory. Without allow-jit the hardened runtime refuses to reserve the code range,
       so any `ELECTRON_RUN_AS_NODE` re-exec dies with "Failed to reserve virtual memory for CodeRange" — which
       is every credential shim and the `styx mcp` server (verified against a signed build, 2026-09-07). -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <!-- Native modules (better-sqlite3, node-pty, @napi-rs/keyring, ssh2) carry our identity, not Apple's. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <!-- Agent CLIs are spawned with a composed environment (PATH, STYX_*, per-grant provider credentials). -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key><true/>
  <key>com.apple.security.network.client</key><true/>
  <key>com.apple.security.network.server</key><true/>
  <key>com.apple.security.files.user-selected.read-write</key><true/>
</dict></plist>
