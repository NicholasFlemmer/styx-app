#!/usr/bin/env node
'use strict';
/**
 * Fake Codex CLI for e2e (apps/desktop/e2e/launch.ts prepends this directory to PATH, so detection and every
 * Codex session in a test land here instead of on a real CLI that would spend the owner's usage).
 *
 *   codex --version      → `codex-cli 0.154.0`
 *   codex --help         → mentions `app-server` and `-c, --config <key=value>` (what DetectService reads)
 *   codex login status   → "Logged in using ChatGPT" on stderr, like the real 0.154.0
 *   codex app-server …   → JSON-RPC 2.0 over stdio (docs/research/agent-parity.md §2.4): answers initialize,
 *                          model/list, account/read, thread/start|resume; every turn/start replays a scripted
 *                          turn — `pong` streamed in two deltas, then a command that asks for approval
 *                          (server request id 100+) and only finishes after the client answers, token usage,
 *                          turn/completed.
 */
const args = process.argv.slice(2);

const HELP = `Codex CLI (fake for e2e)

Usage: codex [OPTIONS] [PROMPT]
       codex [OPTIONS] <COMMAND>

Commands:
  exec        Run Codex non-interactively
  login       Manage login
  app-server  [experimental] Run the app server or related tooling
  mcp         Manage MCP servers

Options:
  -c, --config <key=value>  Override a configuration value from config.toml
  -m, --model <MODEL>       Model the agent should use
  -h, --help                Print help
  -V, --version             Print version
`;

if (args[0] === '--version' || args[0] === '-V') {
  process.stdout.write('codex-cli 0.154.0\n');
  process.exit(0);
}
if (args[0] === '--help' || args[0] === '-h' || args.length === 0) {
  process.stdout.write(HELP);
  process.exit(0);
}
if (args[0] === 'login' && args[1] === 'status') {
  process.stderr.write('Logged in using ChatGPT\n');
  process.exit(0);
}
if (args[0] !== 'app-server') {
  process.stderr.write(`fake codex: ${args.join(' ')} is not supported\n`);
  process.exit(2);
}

// --- app-server ---------------------------------------------------------------

const send = (o) => process.stdout.write(`${JSON.stringify(o)}\n`);
const now = () => Date.now();
let threadId = null;
let cwd = process.cwd();
let turnCount = 0;
let requestId = 100;
/** Server → client requests waiting for an answer, by id. */
const waiting = new Map();

const MODELS = {
  data: [
    {
      id: 'gpt-6-astra',
      model: 'gpt-6-astra',
      displayName: 'GPT-6 Astra',
      description: 'Frontier model',
      hidden: false,
      supportedReasoningEfforts: [
        { reasoningEffort: 'low', description: '' },
        { reasoningEffort: 'medium', description: '' },
        { reasoningEffort: 'high', description: '' },
        { reasoningEffort: 'ultra', description: '' },
      ],
      defaultReasoningEffort: 'low',
      inputModalities: ['text', 'image'],
      isDefault: true,
    },
    {
      id: 'gpt-5.5',
      model: 'gpt-5.5',
      displayName: 'GPT-5.5',
      description: 'Previous generation',
      hidden: false,
      supportedReasoningEfforts: [
        { reasoningEffort: 'low', description: '' },
        { reasoningEffort: 'medium', description: '' },
        { reasoningEffort: 'high', description: '' },
        { reasoningEffort: 'xhigh', description: '' },
      ],
      defaultReasoningEffort: 'xhigh',
      inputModalities: ['text', 'image'],
      isDefault: false,
    },
  ],
  nextCursor: null,
};

const thread = () => ({
  id: threadId,
  sessionId: threadId,
  preview: '',
  ephemeral: false,
  model: 'gpt-6-astra',
  status: { type: 'idle' },
  cwd,
  cliVersion: '0.154.0',
  originator: 'styx',
  turns: [],
});

const threadResponse = (params) => ({
  thread: thread(),
  model: (params && params.model) || 'gpt-6-astra',
  modelProvider: 'openai',
  serviceTier: null,
  cwd,
  instructionSources: [],
  approvalPolicy: (params && params.approvalPolicy) || 'on-request',
  approvalsReviewer: (params && params.approvalsReviewer) || 'user',
  sandbox: { type: 'workspaceWrite', writableRoots: [cwd], networkAccess: true, excludeTmpdirEnvVar: false, excludeSlashTmp: false },
  reasoningEffort: null,
});

const turnShape = (id, status, extra) => ({
  id,
  items: [],
  itemsView: 'notLoaded',
  status,
  error: null,
  startedAt: null,
  completedAt: null,
  durationMs: null,
  ...extra,
});

const request = (method, params) =>
  new Promise((resolve) => {
    const id = requestId++;
    waiting.set(id, resolve);
    send({ id, method, params });
  });

async function runTurn(m) {
  const turnId = `turn_${++turnCount}`;
  const text = ((m.params && m.params.input) || []).map((i) => i.text || '').join(' ');
  send({ id: m.id, result: { turn: turnShape(turnId, 'inProgress') } });
  const note = (method, params) => send({ method, params: { threadId, ...params }, emittedAtMs: now() });
  note('thread/status/changed', { status: { type: 'active', activeFlags: [] } });
  note('turn/started', { turn: turnShape(turnId, 'inProgress', { startedAt: Math.floor(now() / 1000) }) });
  const user = { type: 'userMessage', id: `user_${turnCount}`, clientId: null, content: [{ type: 'text', text, text_elements: [] }] };
  note('item/started', { item: user, turnId, startedAtMs: now() });
  note('item/completed', { item: user, turnId, completedAtMs: now() });

  const msgId = `msg_${turnCount}`;
  note('item/started', { item: { type: 'agentMessage', id: msgId, text: '', phase: 'final_answer' }, turnId, startedAtMs: now() });
  note('item/agentMessage/delta', { turnId, itemId: msgId, delta: 'po' });
  note('item/agentMessage/delta', { turnId, itemId: msgId, delta: 'ng' });
  note('item/completed', { item: { type: 'agentMessage', id: msgId, text: 'pong', phase: 'final_answer' }, turnId, completedAtMs: now() });

  const cmdId = `cmd_${turnCount}`;
  const command = 'echo hi';
  const cmd = (extra) => ({
    type: 'commandExecution',
    id: cmdId,
    pluginId: null,
    scriptPath: null,
    command,
    cwd,
    processId: null,
    source: 'agent',
    status: 'inProgress',
    commandActions: [],
    aggregatedOutput: null,
    exitCode: null,
    durationMs: null,
    ...extra,
  });
  note('item/started', { item: cmd({}), turnId, startedAtMs: now() });
  note('thread/status/changed', { status: { type: 'active', activeFlags: ['waitingOnApproval'] } });
  const answer = await request('item/commandExecution/requestApproval', {
    kind: 'command',
    threadId,
    turnId,
    itemId: cmdId,
    startedAtMs: now(),
    approvalId: null,
    environmentId: null,
    reason: 'the sandbox has no network',
    command,
    cwd,
    commandActions: [],
  });
  note('thread/status/changed', { status: { type: 'active', activeFlags: [] } });
  const decision = answer && answer.decision;
  if (decision === 'accept' || decision === 'acceptForSession') {
    note('item/commandExecution/outputDelta', { turnId, itemId: cmdId, delta: 'hi\n' });
    note('item/completed', {
      item: cmd({ status: 'completed', aggregatedOutput: 'hi\n', exitCode: 0, durationMs: 3 }),
      turnId,
      completedAtMs: now(),
    });
  } else {
    note('item/completed', { item: cmd({ status: 'declined' }), turnId, completedAtMs: now() });
  }
  const usage = { totalTokens: 1234 * turnCount, inputTokens: 1200 * turnCount, cachedInputTokens: 0, cacheWriteInputTokens: 0, outputTokens: 34 * turnCount, reasoningOutputTokens: 0 };
  note('thread/tokenUsage/updated', { turnId, tokenUsage: { total: usage, last: usage, modelContextWindow: 258400 } });
  send({
    method: 'account/rateLimits/updated',
    params: {
      rateLimits: {
        limitId: 'codex',
        limitName: null,
        normalModelSlug: null,
        primary: { usedPercent: 3, windowDurationMins: 300, resetsAt: Math.floor(now() / 1000) + 3600 },
        secondary: { usedPercent: 1, windowDurationMins: 10080, resetsAt: Math.floor(now() / 1000) + 86400 },
        credits: null,
        individualLimit: null,
        spendControlReached: null,
        planType: 'team',
        rateLimitReachedType: null,
      },
    },
    emittedAtMs: now(),
  });
  note('thread/status/changed', { status: { type: 'idle' } });
  note('turn/completed', {
    turn: turnShape(turnId, 'completed', { completedAt: Math.floor(now() / 1000), durationMs: 50 }),
  });
}

function onMessage(m) {
  if (m.method === undefined) {
    // An answer to one of our requests (approval, question).
    const resolve = waiting.get(m.id);
    if (resolve) {
      waiting.delete(m.id);
      resolve(m.result !== undefined ? m.result : { error: m.error });
    }
    return;
  }
  if (m.id === undefined) return; // notification (`initialized`)
  const params = m.params || {};
  switch (m.method) {
    case 'initialize':
      send({ id: m.id, result: { userAgent: 'codex-fake/0.154.0', codexHome: '/tmp/codex-fake', platformFamily: 'unix', platformOs: 'macos' } });
      return;
    case 'model/list':
      send({ id: m.id, result: MODELS });
      return;
    case 'account/read':
      send({ id: m.id, result: { account: { type: 'chatgpt', email: 'nic@fake.dev', planType: 'team' } } });
      return;
    case 'getAuthStatus':
      send({ id: m.id, result: { authMethod: 'chatgpt', requiresOpenaiAuth: true } });
      return;
    case 'thread/start':
    case 'thread/resume':
      threadId = m.method === 'thread/resume' ? params.threadId : 'thr_fake';
      if (typeof params.cwd === 'string' && params.cwd !== '') cwd = params.cwd;
      send({ id: m.id, result: threadResponse(params) });
      send({ method: 'thread/started', params: { thread: thread() }, emittedAtMs: now() });
      return;
    case 'turn/start':
      if (threadId === null) return send({ id: m.id, error: { code: -32000, message: 'no thread' } });
      void runTurn(m);
      return;
    case 'turn/steer':
      send({ id: m.id, result: { turnId: `turn_${turnCount}` } });
      return;
    case 'turn/interrupt':
      send({ id: m.id, result: {} });
      return;
    case 'thread/compact/start':
      send({ id: m.id, result: {} });
      send({ method: 'item/completed', params: { threadId, turnId: `turn_${turnCount}`, item: { type: 'contextCompaction', id: 'cc_1' }, completedAtMs: now() } });
      return;
    case 'review/start':
      send({ id: m.id, result: { turn: turnShape(`turn_${turnCount + 1}`, 'inProgress'), reviewThreadId: threadId } });
      return;
    default:
      send({ id: m.id, error: { code: -32601, message: `fake codex: ${m.method} is not supported` } });
  }
}

let buffer = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (chunk) => {
  buffer += chunk;
  let nl = buffer.indexOf('\n');
  while (nl >= 0) {
    const line = buffer.slice(0, nl).trim();
    buffer = buffer.slice(nl + 1);
    if (line) {
      try {
        onMessage(JSON.parse(line));
      } catch (e) {
        process.stderr.write(`fake codex: bad line: ${e.message}\n`);
      }
    }
    nl = buffer.indexOf('\n');
  }
});
process.stdin.on('end', () => process.exit(0));
