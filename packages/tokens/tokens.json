{
  "$schema": "styx design tokens v1",
  "color": {
    "dark": {
      "page": "#181916",
      "bg": "#0d0e0c",
      "surface1": "#121411",
      "surface2": "#1c1e1a",
      "line": "#2d302a",
      "text": "#e9ebe3",
      "muted": "#858a81",
      "accent": "#d6ff3d",
      "accentInk": "#0d0e0c",
      "accentText": "#d6ff3d",
      "diffAdd": "rgba(214,255,61,0.13)",
      "terminal": "#080908",
      "terminalText": "#c9cdc2",
      "dim": "rgba(0,0,0,0.6)"
    },
    "light": {
      "page": "#d7d8d1",
      "bg": "#eeefe9",
      "surface1": "#f7f8f3",
      "surface2": "#e1e3db",
      "line": "#b3b7ab",
      "text": "#14160f",
      "muted": "#5d6259",
      "accent": "#c6f20f",
      "accentInk": "#14160f",
      "accentText": "#6e8f00",
      "diffAdd": "rgba(150,200,0,0.2)",
      "terminal": "#14160f",
      "terminalText": "#d5d8cc",
      "dim": "rgba(20,22,15,0.45)"
    },
    "semantic": {
      "needsYou": "{accent}",
      "prod": "{accent}",
      "working": "{text}",
      "idle": "{line}",
      "selected": "{text} on {bg} (inverted)",
      "activeToggle": "{accent} on {accentInk}"
    }
  },
  "font": {
    "ui": {
      "family": "Archivo, system-ui, sans-serif",
      "weights": [400, 500, 600, 700]
    },
    "mono": {
      "family": "JetBrains Mono, ui-monospace, monospace",
      "weights": [400, 500]
    }
  },
  "type": {
    "label": {
      "size": 12,
      "weight": 500,
      "tracking": "0",
      "transform": "none",
      "color": "{muted}"
    },
    "labelStrong": {
      "size": 12,
      "weight": 600,
      "tracking": "0",
      "transform": "none"
    },
    "tag": {
      "size": 9,
      "weight": 700,
      "tracking": "0.1em",
      "transform": "uppercase",
      "padding": "1px 5px",
      "border": "1px {line}"
    },
    "body": {
      "size": 14,
      "weight": 400,
      "lineHeight": 1.5
    },
    "bodySmall": {
      "size": 12.5,
      "weight": 400,
      "lineHeight": 1.5
    },
    "bodyStrong": {
      "size": 14,
      "weight": 600
    },
    "mono": {
      "size": 12,
      "lineHeight": 1.6
    },
    "code": {
      "size": 12.5,
      "lineHeight": 1.75
    },
    "monoMeta": {
      "size": 11,
      "color": "{muted}"
    },
    "titleScreen": {
      "size": 18,
      "weight": 600
    },
    "titleSheet": {
      "size": 20,
      "weight": 600,
      "lineHeight": 1.2
    },
    "titleSection": {
      "size": 22,
      "weight": 600,
      "tracking": "-0.01em"
    },
    "headline": {
      "size": 28,
      "weight": 600,
      "tracking": "-0.02em"
    },
    "numeralMedium": {
      "size": 28,
      "weight": 600,
      "tracking": "-0.02em",
      "numeric": "tabular-nums"
    },
    "numeralLarge": {
      "size": 56,
      "weight": 600,
      "tracking": "-0.03em",
      "numeric": "tabular-nums"
    }
  },
  "space": {
    "unit": 4,
    "scale": [4, 6, 8, 10, 12, 14, 16, 18, 20, 24, 32, 40]
  },
  "size": {
    "window": {
      "width": 1280,
      "height": 800,
      "minWidth": 1100,
      "minHeight": 680
    },
    "titlebar": 38,
    "rail": 56,
    "nav": 216,
    "filesPane": 200,
    "chatPane": 360,
    "sheet": 360,
    "auditDrawer": 380,
    "policiesPane": 380,
    "settingsNav": 220,
    "tabRow": 34,
    "hunkBar": 40,
    "terminal": 130,
    "statusBar": 26,
    "palette": 640,
    "modalConnect": 560,
    "modalSpawn": 600,
    "toast": 340,
    "popout": [400, 500],
    "railTile": 36,
    "checkbox": 14,
    "policyCheckbox": 16,
    "statusDot": 8,
    "sessionDot": 7,
    "controlMinHit": 28
  },
  "radius": 0,
  "shadow": "none",
  "border": {
    "hairline": "1px solid {line}",
    "strong": "1px solid {text}",
    "dashed": "1px dashed {line}",
    "accent": "1px solid {accent}"
  },
  "motion": {
    "blink": "1s steps(1) infinite",
    "sheetIn": "160ms cubic-bezier(.2,.8,.2,1) translateX(100%\u21920)",
    "modalIn": "120ms ease-out opacity",
    "toastIn": "160ms ease-out translateY(-8px\u21920)",
    "hover": "0ms (instant background swap)"
  },
  "shortcuts": {
    "palette": "Mod+K",
    "switchProject": "Mod+P",
    "focusAgent": "Mod+1..4",
    "popoutChat": "Mod+Shift+O",
    "approve": "Mod+Enter",
    "deny": "Mod+Backspace",
    "diffAccept": "a",
    "diffReject": "r",
    "diffNext": "j",
    "diffPrev": "k",
    "diffDone": "Mod+Enter",
    "spawnAgent": "Mod+Shift+N",
    "toggleTheme": "Mod+Shift+T",
    "close": "Escape"
  },
  "colorLane": {
    "$comment": "ADR-0027 \u00a77: not in the handoff. Agent squares, and paper (the light theme's surfaces) for results in both themes.",
    "dark": {
      "agentClaude": "#e8916a",
      "agentCodex": "#8fb3ff",
      "agentGemini": "#b79bff",
      "agentCursor": "#e9ebe3",
      "agentShell": "#858a81",
      "paper": "#f7f8f3",
      "paperSurface": "#e1e3db",
      "paperLine": "#b3b7ab",
      "paperText": "#14160f",
      "paperMuted": "#5d6259",
      "paperAccentText": "#6e8f00",
      "paperAdd": "rgba(150,200,0,0.2)",
      "paperRemove": "rgba(200,70,40,0.13)",
      "remove": "rgba(255,110,80,0.14)"
    },
    "light": {
      "agentClaude": "#c4673f",
      "agentCodex": "#3d63d1",
      "agentGemini": "#7a4fd1",
      "agentCursor": "#14160f",
      "agentShell": "#5d6259",
      "paper": "#ffffff",
      "paperSurface": "#eeefe9",
      "paperLine": "#b3b7ab",
      "paperText": "#14160f",
      "paperMuted": "#5d6259",
      "paperAccentText": "#6e8f00",
      "paperAdd": "rgba(150,200,0,0.2)",
      "paperRemove": "rgba(200,70,40,0.13)",
      "remove": "rgba(200,70,40,0.13)"
    }
  }
}
